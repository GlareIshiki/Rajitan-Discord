# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_token_here
DISCORD_GUILD_ID=your_guild_id_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek Configuration (agent system uses this if set)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq Configuration (optional — enables Groq GPT-OSS models via /model)
GROQ_API_KEY=

# YouTube Data API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here

# Spotify Web API Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Google Calendar Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.glareishiki.com/api/google/callback

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Database Configuration
DATABASE_URL=sqlite:///rajitan.db

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO
CONVERSATION_TIMEOUT=3600
SUMMARY_INTERVAL=1800
QUIZ_INTERVAL=3600
MUSIC_INTERVAL=2700

# Google AI (Nanobanana / Gemini) — AI Image Generation
GOOGLE_AI_API_KEY=

# Canva Connect API
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://api.glareishiki.com/api/canva/callback

# HalfMaid Configuration
HALFMAID_DISCORD_TOKEN=your_music_bot_token_here
HALFMAID_API_HOST=127.0.0.1
HALFMAID_API_PORT=8001
HALFMAID_API_URL=http://localhost:8001
HALFMAID_DEFAULT_VOLUME=50
HALFMAID_IDLE_TIMEOUT=300

# API Server Configuration (FastAPI)
API_ENABLED=True
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000